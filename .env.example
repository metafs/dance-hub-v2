# Add only variables that are actually required by the implementation.
# Never commit real secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public origin of this deployment, e.g. https://p8ce.example
# Optional. Without it the sitemap is empty and Open Graph URLs stay relative.
NEXT_PUBLIC_SITE_URL=

# Cloudflare Turnstile (required as a pair for the public listing request form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Server-only privileged credentials (only if an approved use case requires them)
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare / R2
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
